{
	"name": "eightshift-boilerplate",
	"description": "Eightshift Boilerplate is a WordPress starter theme that helps you build better and faster using the modern development tools.",
	"private": true,
	"license": "MIT",
	"scripts": {
		"lintStyle": "stylelint **/*.css",
		"lintJs": "eslint src/",
		"lint": "bun run lintStyle && bun run lintJs",
		"start": "webpack --watch --mode development",
		"build": "webpack --mode production",
		"prepare": "cd ../../.. && husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"webpack": "^5.106.2",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@eightshift/frontend-libs-tailwind": "^3.2.0",
		"@eightshift/ui-components": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.0",
		"colorjs.io": "^0.5.2",
		"glob": "^13.0.6",
		"tailwindcss": "^4.3.0",
		"use-sync-external-store": "^1.6.0"
	},
	"lint-staged": {
		"*.js": "bun lintJs",
		"*.css": "bun lintStyle",
		"*.php": "composer test"
	}
}
